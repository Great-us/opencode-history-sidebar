{
  "compilerOptions": {
    "target": "ES2022", "module": "Node16", "moduleResolution": "Node16",
    "outDir": "out", "rootDir": ".", "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "sourceMap": true, "rewriteRelativeImportExtensions": true, "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
