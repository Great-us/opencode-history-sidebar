{
  "name": "opencode-history-sidebar",
  "displayName": "OpenCode History",
  "description": "Browse local OpenCode history by workspace folder and reopen session terminals in their original working directory.",
  "publisher": "AlexWonton",
  "version": "0.1.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only browsing works in untrusted workspaces; opening an OpenCode terminal requires a trusted workspace.",
      "restrictedConfigurations": [
        "opencodeHistory.enginePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/shared*.js out/test/live*.js out/test/ui*.js out/test/preview-follow*.js",
    "test:extension": "npm run compile && node test/run-extension.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --target win32-x64 --readme-path MARKETPLACE.md --allow-missing-repository"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeHistory",
          "title": "OpenCode History",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "views": {
      "opencodeHistory": [
        {
          "id": "opencodeHistory.sessions",
          "name": "History",
          "icon": "media/opencode.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeHistory.refresh",
        "title": "OpenCode: Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeHistory.search",
        "title": "OpenCode: Search Titles or Folders",
        "icon": "$(search)"
      },
      {
        "command": "opencodeHistory.filter",
        "title": "OpenCode: Filter by Archive State",
        "icon": "$(filter)"
      },
      {
        "command": "opencodeHistory.chooseEngine",
        "title": "OpenCode: Select Engine",
        "icon": "$(gear)"
      },
      {
        "command": "opencodeHistory.restore",
        "title": "OpenCode: Restore Backup",
        "icon": "$(history)"
      },
      {
        "command": "opencodeHistory.open",
        "title": "OpenCode: Open Session Terminal"
      },
      {
        "command": "opencodeHistory.preview",
        "title": "OpenCode: Read-only Preview"
      },
      {
        "command": "opencodeHistory.openParent",
        "title": "OpenCode: Open Parent Main Session Terminal"
      },
      {
        "command": "opencodeHistory.archive",
        "title": "OpenCode: Archive"
      },
      {
        "command": "opencodeHistory.unarchive",
        "title": "OpenCode: Unarchive"
      },
      {
        "command": "opencodeHistory.delete",
        "title": "OpenCode: Delete (Recoverable)"
      },
      {
        "command": "opencodeHistory.recoverLegacy",
        "title": "OpenCode: Import Legacy Record into New Version"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeHistory.refresh",
          "when": "view == opencodeHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "opencodeHistory.search",
          "when": "view == opencodeHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "opencodeHistory.filter",
          "when": "view == opencodeHistory.sessions",
          "group": "navigation@3"
        },
        {
          "command": "opencodeHistory.chooseEngine",
          "when": "view == opencodeHistory.sessions",
          "group": "navigation@4"
        },
        {
          "command": "opencodeHistory.restore",
          "when": "view == opencodeHistory.sessions",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "opencodeHistory.preview",
          "when": "view == opencodeHistory.sessions && viewItem =~ /session/",
          "group": "1_open@1"
        },
        {
          "command": "opencodeHistory.open",
          "when": "view == opencodeHistory.sessions && viewItem =~ /root/ && !(viewItem =~ /legacy/)",
          "group": "1_open@2"
        },
        {
          "command": "opencodeHistory.openParent",
          "when": "view == opencodeHistory.sessions && viewItem =~ /child/ && !(viewItem =~ /legacy/)",
          "group": "1_open@2"
        },
        {
          "command": "opencodeHistory.archive",
          "when": "view == opencodeHistory.sessions && viewItem =~ /session/ && !(viewItem =~ /selfArchived/)",
          "group": "2_manage@1"
        },
        {
          "command": "opencodeHistory.unarchive",
          "when": "view == opencodeHistory.sessions && viewItem =~ /selfArchived/",
          "group": "2_manage@1"
        },
        {
          "command": "opencodeHistory.delete",
          "when": "view == opencodeHistory.sessions && viewItem =~ /session/ && !(viewItem =~ /legacy/)",
          "group": "3_delete"
        },
        {
          "command": "opencodeHistory.recoverLegacy",
          "when": "view == opencodeHistory.sessions && viewItem =~ /legacy/",
          "group": "4_legacy"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode History",
      "properties": {
        "opencodeHistory.enginePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the native OpenCode executable on this machine. Leave empty for automatic discovery."
        }
      }
    }
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/vscode": "1.144.0",
    "@types/node": "24.19.2",
    "@types/markdown-it": "14.2.0",
    "typescript": "7.0.2",
    "@vscode/vsce": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Great-us/opencode-history-sidebar.git"
  },
  "homepage": "https://github.com/Great-us/opencode-history-sidebar",
  "bugs": {
    "url": "https://github.com/Great-us/opencode-history-sidebar/issues"
  },
  "author": "Great-us",
  "keywords": [
    "history",
    "sessions",
    "workspace",
    "opencode"
  ],
  "icon": "media/icon.png"
}
